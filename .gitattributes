# Pacotes de dados nunca entram no Git (vão para GitHub Releases).
*.upk binary
*.upk.zst binary
*.zst binary

# JSON de manifestos e índice: texto, LF sempre.
*.json text eol=lf

# Fixtures lexicais têm Latin-1/CRLF e hashes dos bytes; Git não pode normalizá-las.
tests/fixtures/bweb/*.csv binary

# Evidências HTTP originais: preservar todos os bytes, inclusive espaços e CRLF.
/auditoria/2026/evidencias/municipios-2t.json -text whitespace=-blank-at-eol,-blank-at-eof
/auditoria/2026/evidencias/totalizacao-presidente-2t.json -text whitespace=-blank-at-eol,-blank-at-eof
/auditoria/2026/evidencias/web/*.html -text whitespace=-blank-at-eol,-blank-at-eof
/auditoria/2026/evidencias/web/*.headers -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
/tests/fixtures/audit-2026/*.csv -text whitespace=cr-at-eol

/auditoria/2026/evidencias/testes-*.txt whitespace=-blank-at-eof
