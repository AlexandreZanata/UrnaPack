{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlexandreZanata/UrnaPack/spec/manifest.schema.json",
  "title": "UrnaPack dataset manifest",
  "type": "object",
  "required": [
    "format_version",
    "election_year",
    "round",
    "state",
    "dataset_type",
    "transform_version",
    "tool_version",
    "source_files",
    "source_urls",
    "packages",
    "package_hashes",
    "record_counts",
    "verification_profile",
    "verification_status"
  ],
  "properties": {
    "format_version": { "type": "integer", "const": 1 },
    "election_year": { "type": "integer", "minimum": 1996, "maximum": 2100 },
    "round": { "type": "integer", "enum": [1, 2] },
    "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "dataset_type": { "type": "string", "enum": ["bu", "rdv", "logs", "resultados", "metadata"] },
    "transform_version": { "type": "string", "minLength": 1 },
    "tool_version": { "type": "string", "minLength": 1 },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes", "url"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "url": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "source_urls": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["name", "sha256", "size_bytes", "records"],
        "properties": {
          "name": { "type": "string", "pattern": "^urnapack-[0-9]{4}-t[12]-[A-Z]{2}-[a-z]+-[0-9]{4}\\.upk\\.zst$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "records": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "package_hashes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "record_counts": { "type": "integer", "minimum": 0 },
    "verification_profile": { "type": "string", "enum": ["forensic", "analytical"] },
    "verification_status": { "type": "string", "enum": ["prepared", "validated", "published", "failed"] }
  },
  "additionalProperties": true
}
