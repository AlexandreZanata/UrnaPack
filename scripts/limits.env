# Limites operacionais centralizados (FONTE ÚNICA).
# Workflows e scripts leem este arquivo; não duplique valores.
# Tamanhos em bytes.

# Maior arquivo aceito no Git tradicional (abaixo do teto do GitHub).
MAX_GIT_FILE_BYTES=83886080

# Maior asset aceito em GitHub Releases (abaixo do teto oficial de 2 GiB).
MAX_RELEASE_ASSET_BYTES=536870912

# Teto de assets por release (limite oficial do GitHub: 1000).
MAX_RELEASE_ASSETS=1000
