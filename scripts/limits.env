# Limites operacionais centralizados (FONTE ÚNICA).
# Workflows e scripts leem este arquivo; não duplique valores.
# Tamanhos em bytes.

# Maior arquivo aceito no Git tradicional (abaixo do teto do GitHub).
MAX_GIT_FILE_BYTES=83886080

# Maior asset aceito em GitHub Releases (abaixo do teto oficial de 2 GiB).
MAX_RELEASE_ASSET_BYTES=536870912

# Teto de assets por release (limite oficial do GitHub: 1000).
MAX_RELEASE_ASSETS=1000

# --- Mapeador estrutural da Etapa 1 (scripts/map_raw_data.py) ---
# Maior arquivo físico aceito no corpus (permite o ZIP de 1,6 GB de MT).
MAX_SOURCE_FILE_BYTES=4294967296
# Maior número de membros por ZIP (MT tem ~42 mil no maior contêiner).
MAX_ZIP_MEMBERS=100000
# Maior tamanho declarado de membro ZIP (permite CSV de ~412 MB).
MAX_ZIP_MEMBER_BYTES=1073741824
# Razão máxima entre soma dos tamanhos declarados e o arquivo ZIP.
MAX_ZIP_EXPANSION_RATIO=1000
# Teto de registros lógicos por CSV (MT tem <1M por CSV).
MAX_CSV_RECORDS=20000000
# Teto de colunas por CSV (maior layout observado tem 45).
MAX_CSV_FIELDS=100
# Teto de bytes por campo lexical (Latin-1: 1 byte por caractere).
MAX_FIELD_BYTES=262144
# Teto de bytes lexicais por registro lógico (inclui aspas e finais de linha).
MAX_RECORD_BYTES=1048576
# Teto de valores distintos por coluna de escopo.
MAX_DISTINCT_VALUES_PER_COLUMN=500000
# Teto da soma dos bytes UTF-8 de valores distintos de escopo retidos.
MAX_PROFILE_VALUE_BYTES=67108864
# Amostra máxima para identificação de formato mágico (opacos).
MAX_SAMPLE_BYTES=65536

# --- Aquisição gerenciada da Etapa 2 (scripts/fetch_source.py) ---
# Teto por arquivo baixado (permite o maior ZIP do acervo).
MAX_FETCH_BYTES=4294967296
# Teto de redirecionamentos HTTP por arquivo.
MAX_FETCH_REDIRECTS=5
# Prazo por operação de rede, em segundos.
FETCH_TIMEOUT_SECS=60

# --- Validador canônico da BU web (scripts/validate_bweb.py) ---
# Teto de chaves de ocorrência distintas (MT t1 tem 891.997).
MAX_BWEB_OCCURRENCE_KEYS=2000000
# Evidências de duplicata retidas no relatório (falha lista, nunca remove).
MAX_BWEB_DUPLICATE_EVIDENCE=50

# --- Pacote BU web e benchmark (implementação Rust) ---
IO_BUFFER_BYTES=1048576
MAX_PACK_MANIFEST_BYTES=1048576
MAX_PACK_BYTES=8589934592

# --- Experimento completo de compressão (MT) ---
DICT_SAMPLE_BYTES=32768
MAX_DICT_TRAIN_BYTES=33554432
MAX_DICTIONARY_BYTES=65536
BENCH_REPETITIONS=3
PARQUET_ROW_GROUP_SMALL=8192
PARQUET_ROW_GROUP_LARGE=65536
COMPRESSION_BLOCK_BYTES=1048576
MAX_ARCHIVE_MANIFEST_BYTES=4194304
BENCH_POLL_MILLIS=100
QUERY_MEMORY_BYTES=1073741824
